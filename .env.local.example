# Copy to .env.local (git-ignored). Values marked PUBLIC ship to the browser.
# On Vercel, set every variable under Project → Settings → Environment Variables.

# ── Sanity (required) ─────────────────────────────────────────────────────────
# https://manage.sanity.io → project → API
NEXT_PUBLIC_SANITY_PROJECT_ID=            # PUBLIC. e.g. abcd1234
NEXT_PUBLIC_SANITY_DATASET=production     # PUBLIC
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-27 # PUBLIC, optional (defaults in sanity/lib/api.ts)
NEXT_PUBLIC_SANITY_PROJECT_TITLE="Stefan Peele II | Digital Archive" # PUBLIC, optional — Studio navbar title
SANITY_API_READ_TOKEN=                    # Viewer token. Required: draft mode + live preview.
SANITY_API_WRITE_TOKEN=                   # Editor token. Required for the newsletter (writes `subscriber` docs).
                                          # Without it the form returns a friendly "subscriptions are offline" error.
SANITY_REVALIDATE_SECRET=                 # Random string; same value in the Sanity webhook → /api/draft-mode/enable/revalidate

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=                           # Booking inquiries + newsletter confirmation emails.
                                          # Sending domain stefanpeele.com must be verified in Resend.

# ── Photography booking (Airtable) ────────────────────────────────────────────
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_CLIENTS_TABLE_ID=
AIRTABLE_SHOOTS_TABLE_ID=
AIRTABLE_WEBHOOK_SECRET=                  # Shared secret for /api/airtable/status

# ── Optional integrations ─────────────────────────────────────────────────────
GITHUB_TOKEN=                             # Optional. Raises GitHub API rate limits for project stats.
NEXT_PUBLIC_WEBMENTION_ENABLED=false      # PUBLIC. Set to "true" AFTER registering stefanpeele.com at https://webmention.io
                                          # (sign in with the site's rel="me" GitHub link). Adds <link rel="webmention"> to <head>.
CSP_REPORT_URI=                           # Optional. Endpoint for Content-Security-Policy-Report-Only reports (e.g. report-uri.com).

# ── Testing ───────────────────────────────────────────────────────────────────
PLAYWRIGHT_BASE_URL=                      # Optional. Run e2e against a deployed URL instead of `npm run start`.

# ── Provided automatically by Vercel (do not set locally) ─────────────────────
# VERCEL_GIT_COMMIT_SHA, VERCEL_GIT_COMMIT_REF, VERCEL_DEPLOYMENT_ID, VERCEL_REGION
# are read by components/Footer.tsx and /api/health for the telemetry block.

# ── Optional article features ───────────────────────────────────────────
# "Ask this article" (Claude). Feature renders nothing when unset.
ANTHROPIC_API_KEY=
# Giscus comments (GitHub Discussions). All three required; renders nothing when unset.
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
