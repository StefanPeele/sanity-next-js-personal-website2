{
  "name": "sanity-template-template-nextjs-personal-website",
  "private": true,
  "scripts": {
    "analyze": "next experimental-analyze --serve",
    "build": "next build --turbopack && sanity manifest extract --path public/studio/static",
    "check": "npm run typegen && tsc --noEmit && npm run lint",
    "dev": "next --turbopack",
    "format": "npx prettier --write . --ignore-path .gitignore",
    "lint": "eslint .",
    "lint:fix": "npm run format && npm run lint -- --fix",
    "predev": "npm run typegen",
    "start": "next start",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "type-check": "next typegen && tsc --noEmit",
    "typegen": "sanity schema extract && sanity typegen generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@next/env": "16.2.1",
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "7.20.0",
    "@sanity/code-input": "^7.0.12",
    "@sanity/icons": "3.7.4",
    "@sanity/image-url": "2.0.3",
    "@sanity/ui": "3.1.14",
    "@sanity/util": "5.18.0",
    "@sanity/vision": "5.18.0",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "airtable": "^0.12.2",
    "d3": "^7.9.0",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "next-sanity": "12.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "resend": "^6.10.0",
    "rxjs": "7.8.2",
    "sanity": "5.18.0",
    "sanity-plugin-asset-source-unsplash": "7.0.5",
    "sanity-plugin-media": "^4.1.1",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "styled-components": "6.3.12",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@playwright/test": "^1.62.1",
    "@sanity/prettier-config": "3.0.0",
    "@types/d3": "^7.4.3",
    "@types/react": "19.2.14",
    "autoprefixer": "10.4.27",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.1",
    "eslint-formatter-gha": "2.0.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "postcss": "8.5.8",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
