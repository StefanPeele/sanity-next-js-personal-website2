# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/studio/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/studio/dist
/public/studio/static

# misc
.DS_Store
*.pem
.vscode
.idea/
*.iml

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# Env files created by scripts for working locally
.env
studio/.env.development
next-env.d.ts

# Playwright
test-results/
playwright-report/

# Scratch probes written by verifier subagents at the repo root. They must never be
# committed -- a `git add -A` during a verification run swept one in (Phase 3, 1450774).
/probe-*.mjs
/verify-*.mjs
/verify-*.json
/_*.mjs

# Verifier subagents write scratch here. One of these was swept into a commit by a
# `git add -A` (c473f5e) and had to be removed again.
tmp-verify/
.scratch-verify/
